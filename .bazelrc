# ──────────────────────────────────────────────────────────────────────────
# Bazel configuration for the SDV applications in this repository.
#
# This file is shared by the two build loops described in docs/sdv-bazel-app.md:
#   * Inner loop  — developer / devcontainer native builds and tests.
#   * Outer loop  — Yocto recipe (layers/meta-sdv) cross-compiling for the image.
# ──────────────────────────────────────────────────────────────────────────

# Use bzlmod (MODULE.bazel) as the dependency system.
common --enable_bzlmod

# Show useful errors and keep output stable for CI logs.
common --color=yes
build --show_timestamps
test --test_output=errors
test --test_summary=terse

# ── Local caches ──────────────────────────────────────────────────────────
# Disk cache speeds up incremental rebuilds for a large C++ codebase without
# needing any remote infrastructure.  Path is overridable per environment.
build --disk_cache=~/.cache/bazel-disk
build --repository_cache=~/.cache/bazel-repo

# ── CI profile ────────────────────────────────────────────────────────────
# Invoked as `bazel ... --config=ci`.  Tuned for ephemeral runners.
build:ci --disk_cache=
build:ci --repository_cache=
build:ci --noshow_progress
build:ci --keep_going
test:ci --keep_going

# ── Build variants (debug / release / secure) ─────────────────────────────
# Bazel-level equivalent of the Yocto DISTRO variants in
# layers/meta-portfolio/conf/distro/ (portfolio-debug / -release / -secure).
# Sets the //tools/variants:build_variant build setting consumed by select()
# in libs/vss-common and friends, plus the matching compilation_mode/strip
# behaviour. See docs/bazel-build-system.md#variant-management.
build:debug --//tools/variants:build_variant=debug
build:debug --compilation_mode=dbg
build:debug --strip=never

build:release --//tools/variants:build_variant=release
build:release --compilation_mode=opt
build:release --strip=always

build:secure --//tools/variants:build_variant=secure
build:secure --compilation_mode=opt
build:secure --strip=always

# ── Remote cache (4th cache tier, self-hosted) ────────────────────────────
# This mirrors the repository's existing three-tier Yocto cache philosophy
# (docker layers, downloads, sstate) by adding a Bazel remote cache tier.
# Disabled by default; enable with `--config=remote-cache` after starting the
# local cache: `scripts/bazel-remote-cache.sh up` (see
# infra/bazel-remote/docker-compose.yml). CI runs an equivalent service
# container — see .github/workflows/bazel-sdv-app.yml.
build:remote-cache --remote_cache=grpc://localhost:9092
build:remote-cache --remote_upload_local_results=true
build:remote-cache --remote_local_fallback
# Build-without-the-bytes: only fetch outputs that are actually needed,
# which dramatically reduces network for large C++ trees.
build:remote-cache --remote_download_minimal

# ── Remote execution (cloud RBE, opt-in) ──────────────────────────────────
# BuildBuddy remote execution + cache + build-results UI. Config-only until
# activated: copy buildbuddy.bazelrc.example to user.bazelrc (git-ignored,
# try-imported below) with a real API key. See
# docs/bazel-build-system.md#remote-execution.
build:remote-exec --remote_executor=grpcs://remote.buildbuddy.io
build:remote-exec --remote_cache=grpcs://remote.buildbuddy.io
build:remote-exec --bes_backend=grpcs://remote.buildbuddy.io
build:remote-exec --bes_results_url=https://app.buildbuddy.io/invocation/
build:remote-exec --remote_timeout=10m
build:remote-exec --jobs=50
build:remote-exec --remote_download_minimal
# Execution platform provided by the BuildBuddy toolchain module (MODULE.bazel).
build:remote-exec --host_platform=@toolchains_buildbuddy//platforms:linux_x86_64
build:remote-exec --platforms=@toolchains_buildbuddy//platforms:linux_x86_64
build:remote-exec --extra_execution_platforms=@toolchains_buildbuddy//platforms:linux_x86_64

# ── Yocto cross-compilation profile ───────────────────────────────────────
# Invoked as `bazel ... --config=yocto-cross`.  The Yocto recipe sources the
# SDK environment (environment-setup-*) first, which exports CC/CXX/CFLAGS/
# LDFLAGS/SYSROOT for the target MACHINE.  Bazel's built-in C++ toolchain
# auto-detection honours CC/CXX, so the cross compiler is picked up from the
# recipe environment.  See layers/meta-sdv recipe and docs/sdv-bazel-app.md.
build:yocto-cross --action_env=CC
build:yocto-cross --action_env=CXX
build:yocto-cross --action_env=CFLAGS
build:yocto-cross --action_env=CXXFLAGS
build:yocto-cross --action_env=LDFLAGS
build:yocto-cross --action_env=SYSROOT
# Hermetic-ish: do not leak host paths beyond the SDK environment above.
build:yocto-cross --incompatible_strict_action_env

# Allow a per-machine / per-user override without editing this file.
try-import %workspace%/.bazelrc.local
try-import %workspace%/user.bazelrc
