# SDV vehicle-signal service — a small COVESA/KUKSA-style Bazel application.
#
# It demonstrates the C/C++/Python stack and the Bazel build that is reused by
# the Yocto recipe in layers/meta-sdv.  Kept intentionally dependency-light so
# the C++ targets build with Bazel's native cc rules and need no network
# fetches inside Yocto (BB_NO_NETWORK friendly).
#
# This is one of two independently-built services (see also
# //apps/sdv-diagnostics-service) that both reuse //libs/vss-common — see
# docs/bazel-build-system.md for the build-graph-partitioning rationale.

load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

# ── C++ service binary ────────────────────────────────────────────────────
cc_binary(
    name = "sdv-vehicle-service",
    srcs = ["src/main.cc"],
    deps = ["//libs/vss-common:signal_store"],
)

# ── Python CLI tool that talks to the same VSS-style signal paths ──────────
py_library(
    name = "vehicle_cli",
    srcs = ["python/vehicle_cli.py"],
    imports = ["apps/sdv-vehicle-service/python"],
)

py_binary(
    name = "vehicle-cli",
    srcs = ["python/vehicle_cli.py"],
    main = "python/vehicle_cli.py",
    imports = ["apps/sdv-vehicle-service/python"],
)

py_test(
    name = "vehicle_cli_test",
    size = "small",
    srcs = ["python/vehicle_cli_test.py"],
    main = "python/vehicle_cli_test.py",
    deps = [":vehicle_cli"],
)
