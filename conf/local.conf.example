# Example Yocto local.conf
# Copy into your build/conf/local.conf and tune for your machine.

MACHINE ??= "qemux86-64"
DISTRO ?= "poky"

# Parallel build tuning.
# Let BitBake auto-detect the available CPU count so this file works on any
# machine size (8-core Codespace, 16-core Codespace, remote worker, etc.).
# Override these to a fixed value if you need to cap resource usage.
BB_NUMBER_THREADS ?= "${@oe.utils.cpu_count()}"
PARALLEL_MAKE ?= "-j ${@oe.utils.cpu_count()}"
PACKAGE_CLASSES ?= "package_rpm"
EXTRA_IMAGE_FEATURES ?= "debug-tweaks"
USER_CLASSES ?= "buildstats"
PATCHRESOLVE = "noop"

BB_DISKMON_DIRS ??= "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    STOPTASKS,${SSTATE_DIR},1G,100K \
    HALT,${TMPDIR},100M,1K \
    HALT,${DL_DIR},100M,1K \
    HALT,${SSTATE_DIR},100M,1K"

# ── SDV Bazel application (layers/meta-sdv) ─────────────────────────────────
# Pull the Bazel-built SDV vehicle-signal service into the image.  Uncomment to
# install it (requires meta-sdv in bblayers.conf and systemd in the image; the
# service unit is auto-enabled via SYSTEMD_AUTO_ENABLE).  See
# docs/sdv-bazel-app.md.
#
# DISTRO_FEATURES:append = " systemd"
# IMAGE_INSTALL:append = " sdv-vehicle-service"
#
# Or install the whole SDV package group:
# IMAGE_INSTALL:append = " packagegroup-sdv"
